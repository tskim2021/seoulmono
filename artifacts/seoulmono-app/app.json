{
  "expo": {
    "name": "ソウルモノ",
    "slug": "seoulmono-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seoulmono",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.seoulmono.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "4",
      "appleTeamId": "L89UNHMAA6",
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E8F4FF"
      },
      "package": "com.seoulmono.app",
      "versionCode": 4,
      "googleServicesFile": "./secrets/google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://seoulmono.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#397AA3",
          "defaultChannel": "seoulmono-news"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {},
    "locales": {
      "ja": "./locales/ja.json"
    },
    "owner": "pinkfighter"
  }
}
